# Optional inbound auth. If set, require Authorization: Bearer <key> or X-Api-Key.
FAKE_PIX_API_KEY=fake-pix-demo

# Shared with AcmePay (Laravel / Nest / Next). HMAC-SHA256 of "${t}.${raw_body}".
WEBHOOK_SECRET=dev-webhook-secret
WEBHOOK_TOLERANCE_SECONDS=300

# HTTP listen port for cmd/provider (fase-1).
PORT=8080

# Postgres DSN. Empty = MemoryStore (tests / go run without compose).
# Compose sets this to the sibling postgres service.
DATABASE_URL=

# Poller tick when DATABASE_URL is set.
OUTBOX_POLL_INTERVAL=200ms

# Host publish for the Go-only compose Postgres (default 5435).
# FORWARD_FAKE_PIX_DB_PORT=5435


# Shared with AcmePay (Laravel / Nest / Next). HMAC-SHA256 of "${t}.${raw_body}".
WEBHOOK_SECRET=dev-webhook-secret
WEBHOOK_TOLERANCE_SECONDS=300

# HTTP listen port for cmd/provider (fase-1).
PORT=8080
