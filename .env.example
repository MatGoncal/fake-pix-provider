# Optional inbound auth. If set, require Authorization: Bearer <key> or X-Api-Key.
FAKE_PIX_API_KEY=fake-pix-demo

# Shared with AcmePay (Laravel / Nest / Next). HMAC-SHA256 of "${t}.${raw_body}".
WEBHOOK_SECRET=dev-webhook-secret
WEBHOOK_TOLERANCE_SECONDS=300

# HTTP listen port for cmd/provider (fase-1).
PORT=8080
